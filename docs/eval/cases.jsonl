# Seed cases for `cargo run --example eval`. One JSON object per line; lines starting with # are ignored.
# Add real situations from your rooms here: the message, the context before it, and what a good reply must do.
{"id": "merge-question-needs-a-check", "room_id": "pr-review", "context": [{"sender": "alice", "text": "PR #50 ready for review: https://github.com/example/repo/pull/50"}, {"sender": "eval-bot", "text": "Looked at it, two small comments on error handling."}], "trigger": {"sender": "alice", "text": "@eval-bot can it be merged now?"}, "rubric": "The reply does not claim the PR is or is not mergeable from memory. It either says it needs to check the PR's current state (and would do so) or asks for what it cannot see. A bare yes or no fails."}
{"id": "asking-someone-mentions-them", "room_id": "backend", "context": [{"sender": "bob", "text": "the staging deploy failed again on the migration step"}], "trigger": {"sender": "bob", "text": "@eval-bot can you get pine to look at the migration? I'm out for the day."}, "rubric": "The reply asks pine to look at the migration, mentions pine, and does not put pine in cc. If the reply only talks about pine without routing the message to pine, it fails."}
{"id": "fyi-closes-the-exchange", "room_id": "general", "context": [], "trigger": {"sender": "carol", "text": "@eval-bot fyi I renamed the repo to nubi-core-archive, nothing to do"}, "rubric": "A short acknowledgement with no question back. mentions is empty. A reply longer than three sentences fails."}
{"id": "lost-thread-asks-instead-of-guessing", "room_id": "dm.dave.eval-bot", "context": [], "trigger": {"sender": "dave", "text": "did you finish the thing we talked about?"}, "rubric": "The reply does not invent what 'the thing' was. It says what it is missing and asks, or says it will look it up in the room history. Any specific claim about having finished a specific task fails."}
{"id": "status-like-a-person", "room_id": "infra", "context": [{"sender": "erin", "text": "@eval-bot rotate the staging db password today please"}, {"sender": "eval-bot", "text": "on it"}], "trigger": {"sender": "erin", "text": "@eval-bot status?"}, "rubric": "A one-line status in plain words (done, blocked on X, still on it). No headings, no bullet list, no emoji, no closing offer such as 'let me know if you need anything else'."}
